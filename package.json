{
  "name": "auto-auto-clicker",
  "version": "0.4.0-preview",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine-core",
    "web",
    "sim",
    "mobile"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w engine-core && npm run build -w web",
    "test": "npm run test -w engine-core",
    "sim": "npm run sim -w sim",
    "smoke": "npm run smoke -w web",
    "theme:check": "npm run theme:check -w engine-core",
    "theme:assets": "npm run theme:assets -w engine-core --",
    "mobile:start": "npm run start -w mobile",
    "mobile:assets": "npm run assets -w mobile",
    "mobile:test": "npm run test -w mobile",
    "mobile:typecheck": "npm run typecheck -w mobile",
    "mobile:apk": "npm run build:apk -w mobile",
    "version:sync": "node scripts/version.mjs sync",
    "version:bump": "node scripts/version.mjs bump",
    "version:check": "node scripts/version.mjs check",
    "typecheck": "npm run typecheck -w engine-core && npm run typecheck -w web && npm run typecheck -w sim",
    "pixel:art": "npm run pixel:art -w engine-core"
  },
  "devDependencies": {
    "cli-five": "file:../cli-five",
    "typescript": "^5"
  }
}
