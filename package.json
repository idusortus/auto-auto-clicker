{
  "name": "auto-auto-clicker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine-core",
    "web",
    "sim"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w engine-core && npm run build -w web",
    "test": "npm run test -w engine-core",
    "sim": "npm run sim -w sim",
    "smoke": "npm run smoke -w web",
    "theme:check": "npm run theme:check -w engine-core",
    "theme:assets": "npm run theme:assets -w engine-core --",
    "typecheck": "npm run typecheck -w engine-core && npm run typecheck -w web && npm run typecheck -w sim"
  },
  "devDependencies": {
    "cli-five": "file:../cli-five",
    "typescript": "^5"
  }
}
